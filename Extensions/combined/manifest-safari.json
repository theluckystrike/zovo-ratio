{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDesc__",
  "default_locale": "en",
  "version": "__RYD_VERSION__",
  "manifest_version": 2,
  "background": {
    "scripts": ["zrx-worker.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/zrx-icon-16.png",
    "48": "icons/zrx-icon-48.png",
    "128": "icons/zrx-icon-128.png"
  },
  "permissions": [
    "activeTab",
    "*://*.youtube.com/*",
    "storage",
    "*://returnyoutubedislikeapi.com/*",
    "https://zgubxqomnbmxgbdhvwja.supabase.co/*"
  ],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://*.music.youtube.com/*"],
      "run_at": "document_idle",
      "css": ["zrx-overlay.css"],
      "js": ["zrx-core.js"]
    }
  ],
  "options_ui": {
    "page": "popup.html"
  }
}
