{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDesc__",
  "default_locale": "en",
  "version": "__RYD_VERSION__",
  "manifest_version": 3,
  "background": {
    "service_worker": "zrx-worker.js"
  },
  "icons": {
    "16": "icons/zrx-icon-16.png",
    "48": "icons/zrx-icon-48.png",
    "128": "icons/zrx-icon-128.png"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://returnyoutubedislikeapi.com/*",
    "https://zgubxqomnbmxgbdhvwja.supabase.co/*"
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/zrx-icon-16.png",
      "48": "icons/zrx-icon-48.png",
      "128": "icons/zrx-icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://*.music.youtube.com/*"
      ],
      "js": [
        "zrx-core.js"
      ],
      "css": [
        "zrx-overlay.css"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "*://*.youtube.com/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "zrx-menu-bridge.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}
